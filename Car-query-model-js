/*==================================================
    CAR QUERY MODEL
    Read Operations
==================================================*/

const BaseModel = require('../../base.model');

class CarQuery extends BaseModel {

    /*==============================================
        GET ALL CARS
    ==============================================*/
    static async getAll(options = {}) {

        const {
            page = 1,
            limit = 10,
            search = '',
            brand = '',
            condition = '',
            status = ''
        } = options;

        const currentPage =
            Math.max(
                parseInt(page, 10) || 1,
                1
            );

        const perPage =
            Math.max(
                parseInt(limit, 10) || 10,
                1
            );

        const offset =
            (currentPage - 1) * perPage;

        const where = [];

        const params = [];

        if (search) {

            where.push(`

                (
                    display_title LIKE ?
                    OR car_code LIKE ?
                    OR model LIKE ?
                )

            `);

            const keyword =
                `%${search}%`;

            params.push(

                keyword,

                keyword,

                keyword

            );

        }

        if (brand) {

            where.push(
                `brand_id = ?`
            );

            params.push(
                brand
            );

        }

        if (condition) {

            where.push(
                '`condition` = ?'
            );

            params.push(
                condition
            );

        }

        if (status) {

            where.push(
                `status = ?`
            );

            params.push(
                status
            );

        }

        const whereSql =
            where.length
                ? `WHERE ${where.join(' AND ')}`
                : '';

        const countSql = `

            SELECT COUNT(*) AS total

            FROM cars

            ${whereSql}

        `;

        const countRows =
            await this.query(

                countSql,

                params

            );

        const total =
            countRows[0]?.total || 0;

        const dataSql = `

            SELECT *

            FROM cars

            ${whereSql}

            ORDER BY id DESC

            LIMIT ?

            OFFSET ?

        `;

        const cars =
            await this.query(

                dataSql,

                [

                    ...params,

                    perPage,

                    offset

                ]

            );

        return {

            cars,

            page: currentPage,

            limit: perPage,

            total,

            totalPages:

                Math.ceil(

                    total / perPage

                )

        };

    }

    /*==============================================
        GET CAR BY ID
    ==============================================*/
    static async getById(id) {

        const sql = `

            SELECT

                c.*,

                b.name AS brand_name,

                b.slug AS brand_slug,

                b.logo AS brand_logo,

                b.country AS brand_country

            FROM cars c

            INNER JOIN brands b

                ON b.id = c.brand_id

            WHERE

                c.id = ?

            LIMIT 1

        `;

        return this.findOne(

            sql,

            [id]

        );

    }
        /*==============================================
        GET CAR BY SLUG
    ==============================================*/
    static async getBySlug(slug) {

        const sql = `

            SELECT

                c.*,

                b.name AS brand_name,

                b.slug AS brand_slug,

                b.logo AS brand_logo,

                b.country AS brand_country

            FROM cars c

            INNER JOIN brands b

                ON b.id = c.brand_id

            WHERE

                c.slug = ?

            LIMIT 1

        `;

        return this.findOne(

            sql,

            [slug]

        );

    }
        /*==============================================
        CHECK CAR CODE EXISTS
    ==============================================*/
    static async existsByCarCode(carCode) {

        const sql = `

            SELECT

                id

            FROM cars

            WHERE

                car_code = ?

            LIMIT 1

        `;

        const result =
            await this.findOne(

                sql,

                [carCode]

            );

        return !!result;

    }

}

module.exports = CarQuery;
