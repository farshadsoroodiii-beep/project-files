DROP TABLE IF EXISTS car_display_locations;

CREATE TABLE car_display_locations (

    -- Primary Key
    id INT UNSIGNED AUTO_INCREMENT,

    -- Relationships
    car_id INT UNSIGNED NOT NULL,
    section_id INT UNSIGNED NOT NULL,

    -- Display
    sort_order INT UNSIGNED NOT NULL DEFAULT 1,

    -- Timestamps
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    -- Primary Key
    CONSTRAINT pk_car_display_locations
        PRIMARY KEY (id),

    -- Prevent duplicate assignments
    CONSTRAINT uq_car_display_locations_car_section
        UNIQUE (car_id, section_id),

    -- Foreign Keys
    CONSTRAINT fk_car_display_locations_car
        FOREIGN KEY (car_id)
        REFERENCES cars(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT fk_car_display_locations_section
        FOREIGN KEY (section_id)
        REFERENCES site_sections(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    -- Indexes
    INDEX idx_car_display_locations_car (car_id),
    INDEX idx_car_display_locations_section (section_id),
    INDEX idx_car_display_locations_section_sort (section_id, sort_order)

) ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;
