/*==================================================
    DL-6B REAL DB INTEGRATION TEST

    Production files are NOT modified.

    Test DB:
        projectcar

    Test cars:
        car 1 = Tiggo 9
        car 4 = Land Cruiser

    Scenarios:

    A) Cross-car position conflict
       - Car 1 attempts to use an SUV position
         already occupied by Car 4.
       - Must fail with:
         DISPLAY_LOCATION_POSITION_CONFLICT
       - Car 1 DB state must remain unchanged.

    B) Same sortOrder across different sections
       - slider-vip = 1
       - sedan      = 1
       - Must be accepted.
       - No DB write is performed.

    C) Successful real save
       - Save Car 1's exact current Display Locations.
       - Final Display Location DB state must remain
         identical to the initial state.
==================================================*/

'use strict';

/*==================================================
    ENVIRONMENT

    IMPORTANT:
    dotenv MUST load before any module that imports
    config/db.js.
==================================================*/

require('dotenv').config({
    path: require('path').resolve(
        __dirname,
        '../../.env'
    )
});

/*==================================================
    DEPENDENCIES
==================================================*/

const assert = require('node:assert/strict');

const BaseModel =
    require('../../models/base.model');

const CompleteEditSaveUseCase =
    require('../../use-cases/admin/cars/complete-edit-save.use-case');

/*==================================================
    TEST CONSTANTS
==================================================*/

const CAR_ID = 1;

const OTHER_CAR_ID = 4;

const SESSION_ID =
    '22222222-2222-4222-8222-222222222222';

/*==================================================
    DB HELPERS
==================================================*/

async function getGallery(carId) {
    return BaseModel.query(
        `
        SELECT
            id,
            car_id,
            image_path,
            sort_order
        FROM car_gallery
        WHERE car_id = ?
        ORDER BY
            sort_order ASC,
            id ASC
        `,
        [carId]
    );
}

async function getLocations(carId) {
    return BaseModel.query(
        `
        SELECT
            cdl.id,
            cdl.car_id,
            cdl.section_id,
            ss.slug,
            cdl.sort_order
        FROM car_display_locations cdl
        INNER JOIN site_sections ss
            ON ss.id = cdl.section_id
        WHERE cdl.car_id = ?
        ORDER BY
            ss.slug ASC,
            cdl.sort_order ASC,
            cdl.id ASC
        `,
        [carId]
    );
}

/*==================================================
    SNAPSHOT

    ID is intentionally excluded.

    We are validating the logical Display Location
    state, not AUTO_INCREMENT identity.
==================================================*/

function locationSnapshot(rows) {
    return rows.map(row => ({
        section_id: Number(row.section_id),
        slug: row.slug,
        sort_order: Number(row.sort_order)
    }));
}

/*==================================================
    INTENT BUILDER

    This must match the real Complete Edit Save
    contract.

    displayLocations:
    {
        locations: [
            {
                location,
                sortOrder
            }
        ]
    }
==================================================*/

function buildIntent(
    gallery,
    displayLocations
) {
    return {
        car: {},

        gallery: {
            sessionId: SESSION_ID,

            order: gallery.map(image => ({
                id: Number(image.id),
                sort_order: Number(image.sort_order)
            })),

            deleted: [],

            added: []
        },

        mainImages: {
            sessionId: SESSION_ID,

            main_image: {
                action: 'keep',
                tempId: null
            },

            background_image: {
                action: 'keep',
                tempId: null
            }
        },

        displayLocations: {
            locations: displayLocations.map(row => ({
                location: row.slug,
                sortOrder: Number(row.sort_order)
            }))
        }
    };
}

/*==================================================
    MAIN TEST
==================================================*/

async function run() {

    console.log(
        'DL-6B REAL DB INTEGRATION TEST'
    );

    /*==================================================
        LOAD AUTHORITATIVE CURRENT DB STATE
    ==================================================*/

    const carLocationsBefore =
        await getLocations(CAR_ID);

    const otherCarLocations =
        await getLocations(OTHER_CAR_ID);

    const gallery =
        await getGallery(CAR_ID);

    assert.ok(
        carLocationsBefore.length > 0,
        'Car 1 must have existing Display Locations.'
    );

    assert.ok(
        otherCarLocations.length > 0,
        'Car 4 must have existing Display Locations.'
    );

    assert.ok(
        gallery.length > 0,
        'Car 1 must have a permanent gallery.'
    );

    /*==================================================
        FIND A REAL OCCUPIED SUV POSITION
        OWNED BY CAR 4
    ==================================================*/

    const otherCarOccupiedSuv =
        otherCarLocations.find(
            row => row.slug === 'suv'
        );

    assert.ok(
        otherCarOccupiedSuv,
        'Car 4 must have an existing SUV Display Location.'
    );

    /*==================================================
        A — REAL CROSS-CAR CONFLICT

        Remove Car 1's current SUV assignment.

        Then replace it with the exact SUV position
        currently occupied by Car 4.

        Example:

            Car 1:
                suv -> 1

            Car 4:
                suv -> 2

        Requested:

            Car 1:
                suv -> 2

        Expected:

            DISPLAY_LOCATION_POSITION_CONFLICT
    ==================================================*/

    const car1WithoutSuv =
        carLocationsBefore.filter(
            row => row.slug !== 'suv'
        );

    const realConflictIntent =
        buildIntent(
            gallery,
            [
                ...car1WithoutSuv,

                {
                    slug: 'suv',

                    sort_order:
                        Number(
                            otherCarOccupiedSuv.sort_order
                        )
                }
            ]
        );

    let conflictCode = null;

    try {

        await CompleteEditSaveUseCase.execute(
            CAR_ID,
            realConflictIntent
        );

    } catch (error) {

        conflictCode =
            error.code;
    }

    assert.equal(
        conflictCode,
        'DISPLAY_LOCATION_POSITION_CONFLICT',
        'Occupied position owned by another car must be rejected.'
    );

    /*==================================================
        A — VERIFY NO PERSISTENCE AFTER CONFLICT
    ==================================================*/

    const afterConflict =
        await getLocations(CAR_ID);

    assert.deepEqual(
        locationSnapshot(afterConflict),
        locationSnapshot(carLocationsBefore),
        'Car 1 Display Locations must remain unchanged after conflict rejection.'
    );

    console.log(
        'A  Cross-car conflict rejection: PASS'
    );

    /*==================================================
        B — SAME SORT ORDER IN DIFFERENT SECTIONS

        Same sortOrder is valid when the location
        (section) is different.

            slider-vip -> 1
            sedan      -> 1

        This is NOT a DB save test.

        Only contract validation and preparation
        are executed.
    ==================================================*/

    const sameOrderIntent =
        buildIntent(
            gallery,
            [
                {
                    slug: 'slider-vip',
                    sort_order: 1
                },

                {
                    slug: 'sedan',
                    sort_order: 1
                }
            ]
        );

    /*--------------------------------------------------
        Contract validation
    --------------------------------------------------*/

    CompleteEditSaveUseCase.validateIntent(
        CAR_ID,
        sameOrderIntent
    );

    /*--------------------------------------------------
        Real site_sections lookup / preparation

        BaseModel.transaction() automatically rolls
        the transaction back after the callback
        because prepareDisplayLocationsIntent()
        performs no write here.

        This confirms that both section slugs resolve
        correctly through the real DB.
    --------------------------------------------------*/

    const preparedSameOrder =
        await BaseModel.transaction(
            async connection => {

                return CompleteEditSaveUseCase
                    .prepareDisplayLocationsIntent(
                        CAR_ID,
                        sameOrderIntent.displayLocations,
                        connection
                    );
            }
        );

    assert.equal(
        preparedSameOrder.length,
        2,
        'Both Display Location assignments must be prepared.'
    );

    assert.deepEqual(
        preparedSameOrder.map(
            item => Number(item.sort_order)
        ),
        [1, 1],
        'Same sort_order must be allowed across different sections.'
    );

    assert.notEqual(
        preparedSameOrder[0].section_id,
        preparedSameOrder[1].section_id,
        'Different section slugs must resolve to different section IDs.'
    );

    console.log(
        'B  Same sortOrder across different sections: PASS'
    );

    /*==================================================
        C — SUCCESSFUL REAL SAVE

        Save Car 1's EXACT CURRENT Display Location
        assignments.

        Because the payload represents the current
        authoritative state, the final logical DB
        state must remain identical.
    ==================================================*/

    const exactIntent =
        buildIntent(
            gallery,
            carLocationsBefore
        );

    const result =
        await CompleteEditSaveUseCase.execute(
            CAR_ID,
            exactIntent
        );

    assert.ok(
        result,
        'Successful Complete Edit Save must return a result.'
    );

    /*==================================================
        VERIFY FINAL DB STATE
    ==================================================*/

    const afterSuccess =
        await getLocations(CAR_ID);

    assert.deepEqual(
        locationSnapshot(afterSuccess),
        locationSnapshot(carLocationsBefore),
        'Exact Display Location save must preserve the final DB state.'
    );

    console.log(
        'C  Exact successful save / final state unchanged: PASS'
    );

    /*==================================================
        FINAL RESULT
    ==================================================*/

    console.log('');
    console.log(
        'DL-6B REAL DB INTEGRATION TEST: PASS'
    );
}

/*==================================================
    TEST ENTRY POINT
==================================================*/

run().catch(error => {

    console.error(
        'DL-6B REAL DB INTEGRATION TEST: FAIL'
    );

    console.error(
        'code:',
        error.code || '(none)'
    );

    console.error(
        'message:',
        error.message
    );

    process.exitCode = 1;
});
