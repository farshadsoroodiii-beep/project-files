DROP TABLE IF EXISTS car_gallery;

CREATE TABLE car_gallery (

    -- Primary Key
    id INT UNSIGNED AUTO_INCREMENT,

    -- Relationship
    car_id INT UNSIGNED NOT NULL,

    -- Image Information
    image_path VARCHAR(255) NOT NULL,
    sort_order INT UNSIGNED NOT NULL DEFAULT 1,

    -- Timestamps
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    -- Primary Key
    CONSTRAINT pk_car_gallery
        PRIMARY KEY (id),

    -- Foreign Key
    CONSTRAINT fk_car_gallery_car
        FOREIGN KEY (car_id)
        REFERENCES cars(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    -- Prevent duplicate sort order for the same car
    CONSTRAINT uq_car_gallery_car_sort
        UNIQUE (car_id, sort_order),

    -- Indexes
    INDEX idx_car_gallery_car (car_id)

) ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;
