/*==================================================
    CAR MODEL (V1.1)
    Vehicle Management Core Model

    Facade Layer

    Delegates:
    - Query Operations
    - Admin Operations
    - Public Operations

==================================================*/

const BaseModel = require('../base.model');

const allowedFields = require('./shared/allowed-fields');

const CarQuery = require('./query/car-query.model');

const CarAdmin = require('./admin/car-admin.model');

const CarPublic = require('./public/car-public.model');

class Car extends BaseModel {

    /*==============================================
        ALLOWED UPDATE FIELDS
    ==============================================*/

    static allowedFields = allowedFields;

    /*==============================================
        QUERY METHODS
    ==============================================*/

    /*==============================================
        GET ALL CARS
        DELEGATED TO QUERY MODEL
    ==============================================*/
    static async getAll(options = {}) {

        return CarQuery.getAll(options);

    }

    /*==============================================
        GET CAR BY ID
        DELEGATED TO QUERY MODEL
    ==============================================*/
    static async getById(id) {

        return CarQuery.getById(id);

    }

    /*==============================================
        GET CAR BY SLUG
        DELEGATED TO QUERY MODEL
    ==============================================*/
    static async getBySlug(slug) {

        return CarQuery.getBySlug(slug);

    }

    /*==============================================
        CHECK CAR CODE EXISTS
        DELEGATED TO QUERY MODEL
    ==============================================*/
    static async existsByCarCode(carCode) {

        return CarQuery.existsByCarCode(carCode);

    }

    /*==============================================
        ADMIN METHODS
    ==============================================*/

    /*==============================================
        CREATE CAR
        DELEGATED TO ADMIN MODEL
    ==============================================*/
    static async create(data) {

        return CarAdmin.create(data);

    }

    /*==============================================
        UPDATE CAR
        DELEGATED TO ADMIN MODEL
    ==============================================*/
    static async update(id, data) {

        return CarAdmin.update(id, data);

    }

    /*==============================================
        DELETE CAR
        DELEGATED TO ADMIN MODEL
    ==============================================*/
    static async delete(id) {

        return CarAdmin.delete(id);

    }

    /*==============================================
        PUBLIC METHODS
    ==============================================*/

    /*==============================================
        GET ACTIVE CARS
        DELEGATED TO PUBLIC MODEL
    ==============================================*/
    static async getActive() {

        return CarPublic.getActive();

    }

    /*==============================================
        GET CARS BY SITE SECTION SLUG
        DELEGATED TO PUBLIC MODEL
    ==============================================*/
    static async getBySectionSlug(slug) {

        return CarPublic.getBySectionSlug(slug);

    }

    /*==============================================
        GET ADMIN DETAILS
        DELEGATED TO PUBLIC MODEL
    ==============================================*/
    static async getAdminDetails(id) {

        return CarPublic.getAdminDetails(id);

    }

}

module.exports = Car;
